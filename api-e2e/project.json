      "dependsOn": ["deployment:build"]
    },
    "hybrid-upgrade-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/hybrid.test.mjs",
        "env": {
          "CC_AUTH_HYBRID_UPGRADE": "1"
        }

{
  "name": "api-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["api"],
  "projectType": "application",
  "targets": {
    "hybrid-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/hybrid.test.mjs"
      },
      "dependsOn": ["deployment:build"]
    },
    "all-docker-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/all-docker.test.mjs"
      },
      "dependsOn": ["deployment:build"]
    },
    "auth-image-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/auth.test.mjs",
        "env": {
          "CC_AUTH_PACKAGED_IMAGES": "true"
        }
      },
      "dependsOn": ["deployment:build"]
    },
    "auth-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/auth.test.mjs"
      },
      "dependsOn": [
        "api:build",
        "frontend:build",
        "worker:build",
        "deployment:build"
      ]
    },
    "phase3-install-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deployment:build"],
      "options": {
        "command": "node --test api-e2e/all-docker.test.mjs",
        "env": {
          "CC_AUTH_PHASE3_WORKFLOWS": "1"
        }
      }
    },
    "phase3-auth-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/auth.test.mjs",
        "env": {
          "CC_AUTH_PHASE": "3"
        }
      },
      "dependsOn": [
        "api:build",
        "frontend:build",
        "worker:build",
        "deployment:build"
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test api-e2e/api.test.mjs api-e2e/evidence-security.test.mjs api-e2e/provider-fixture.test.mjs api-e2e/all-docker-faults-fixture.test.mjs"
      },
      "dependsOn": ["api:build"]
    },
    "kubernetes-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/kubernetes.test.mjs"
      },
      "dependsOn": ["deployment:build"]
    },
    "upgrade-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test api-e2e/upgrade.test.mjs",
        "env": {
          "CC_INSTALLER_FAULTS": "1"
        }
      },
      "dependsOn": ["deployment:build"]
    },
    "screen-reader-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "dbus-run-session -- xvfb-run -a node --test api-e2e/all-docker.test.mjs",
        "env": {
          "CC_AUTH_SCREEN_READER": "1"
        }
      },
      "dependsOn": ["deployment:build"]
    },
    "phase3-restore-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deployment:build"],
      "options": {
        "command": "node --test api-e2e/all-docker.test.mjs",
        "env": {
          "CC_AUTH_PHASE3_RESTORE": "1"
        }

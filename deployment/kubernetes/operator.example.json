    "kestraInternal": "district-rwx"
  },
  "release": {
    "schemaVersion": 1,
    "sourceRevision": "1111111111111111111111111111111111111111",
    "architectures": ["linux/amd64"],
    "images": {
      "frontend": "registry.example.org/campus-commander/frontend@sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "api": "registry.example.org/campus-commander/api@sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "workers": "registry.example.org/campus-commander/workers@sha256:3333333333333333333333333333333333333333333333333333333333333333"
    }

{
  "name": "deployment",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "deployment/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "installer-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/installer/*.test.mjs"
      }
    },
    "kubernetes-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/kubernetes/*.test.mjs"
      }
    },
    "kubernetes-render": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/cli.mjs"
      }
    },
    "release-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test deployment/release/*.test.mjs"
      }
    },
    "storage-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test deployment/storage/*.test.mjs"
      }
    },
    "storage-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node deployment/storage/integration.mjs"
      }
    },
    "bootstrap-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/bootstrap/*.test.mjs"
      }
    },
    "redis-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/redis/*.test.mjs"
      }
    },
    "postgres-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test deployment/postgres/*.test.mjs"
      }
    },
    "postgres-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node deployment/postgres/integration.mjs"
      },
      "dependsOn": ["build"]
    },
    "qualify-redis": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/redis/qualify.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/deployment"],
      "options": {
        "command": "tsc -p deployment/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "deployment",
        "command": "vitest run"
      },
      "dependsOn": ["build"]
    },
    "validate-examples": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/deployment/cli.js --examples"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/deployment/cli.js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc -p deployment/tsconfig.spec.json --noEmit"
      }
    },
    "profiles-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/profiles/*/*.test.mjs"
      }
    },
    "profiles-render": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/profiles/all-docker/render.mjs"
      }
    },
    "operations-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/operations/*.test.mjs"
      }
    },
    "operations-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/operations/integration.mjs"
      }
    },
    "qualification-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node --test deployment/qualification/*.test.mjs"
      }
    },
    "operations-profile-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/operations/profile-integration.mjs"
      }
    },
    "qualification-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/qualification/cli.mjs"
      }
    },
    "capacity-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/qualification/capacity-integration.mjs"
      }
    },
    "installer-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/installer/integration.mjs"
      }
    },
    "kubernetes-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/integration.mjs"
      }
    },
    "hybrid-render": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/profiles/hybrid/render.mjs"
      }
    },
    "hybrid-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/profiles/hybrid/integration.mjs"
      }
    },
    "operations-native-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "CC_OPERATIONS_NATIVE=1 node deployment/operations/integration.mjs"
      }
    },
    "hybrid-full-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/profiles/hybrid/full-integration.mjs"
      }
    },
    "installer-tls-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "CC_INSTALLER_FAULTS=1 node deployment/installer/integration.mjs"
      }
    },
    "kubernetes-restore-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/restore-integration.mjs"
      }
    },
    "installer-browser-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "CC_INSTALLER_FAULTS=1 CC_INSTALLER_BROWSER=1 node deployment/installer/integration.mjs"
      }
    },
    "hybrid-restore-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/profiles/hybrid/restore-integration.mjs"
      }
    },
    "profile-capacity-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/qualification/profile-capacity-integration.mjs"
      }
    },
    "hybrid-process-fault-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "CC_HYBRID_PROCESS_FAULTS=true node deployment/profiles/hybrid/full-integration.mjs"
      }
    },
    "kubernetes-fault-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/fault-integration.mjs"
      }
    },
    "kubernetes-network-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/network-integration.mjs"
      }
    },
    "kubernetes-certificate-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kubernetes/certificate-integration.mjs"
      }
    },
    "hybrid-lifecycle-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/installer/hybrid-lifecycle-integration.mjs"
      }
    },
    "kubernetes-lifecycle-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/installer/kubernetes-lifecycle-integration.mjs"
      }
    },
    "kestra-database-recovery-probe": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node deployment/kestra/database-recovery-probe.mjs"
      }
    },
    "operations-cli-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "CC_OPERATIONS_CLI=1 node deployment/operations/integration.mjs"
      }
    }
  }
}
